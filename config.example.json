{
  "store": {
    "kind": "files",
    "path": ".taskmaster/taskmaster.db"
  },
  "auth": {
    "issuer": "https://commons.example.invalid",
    "allow": ["github:replace-me"]
  },
  "commons": {
    "remote": "https://commons.example.invalid",
    "token": "replace-me-with-a-token-from-the-commons-account-page",
    "share": false,
    "report": true
  },
  "approvals": {
    "mode": "never",
    "timeout_secs": 600
  },
  "editor": "",
  "preview": {
    "command": ""
  },
  "telemetry": {
    "enabled": false
  },
  "code_mode": {
    "enabled": true,
    "script_secs": 600,
    "sh_secs": 300
  },
  "sandbox": {
    "shell": true,
    "package_indexes": true
  },
  "web_access": {
    "enabled": true,
    "provider": "native",
    "endpoint": "",
    "roles": {
      "planner": { "search": true, "fetch": true },
      "worker": { "search": true, "fetch": true },
      "reviewer": { "search": false, "fetch": true },
      "verifier": { "search": false, "fetch": false }
    },
    "allowlist": [],
    "planner_max_searches": 5,
    "planner_max_fetches": 8,
    "worker_max_fetches": 5,
    "native_search_max_planner": 5,
    "native_search_max_worker": 3
  },
  "scout": {
    "enabled": true,
    "min_files": 25
  },
  "prices_file": "",
  "prices": {}
}
