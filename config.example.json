{
  "store": {
    "kind": "files",
    "path": ".taskmaster/taskmaster.db"
  },
  "auth": {
    "issuer": "https://commons.example.invalid",
    "allow": ["github:replace-me"]
  },
  "commons": {
    "remote": "https://commons.example.invalid",
    "token": "replace-me-with-a-token-from-the-commons-account-page",
    "share": false,
    "report": true
  },
  "approvals": {
    "mode": "never",
    "timeout_secs": 600
  },
  "editor": "",
  "preview": {
    "command": ""
  },
  "telemetry": {
    "enabled": false
  }
}
