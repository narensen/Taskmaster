# The Taskmaster Commons. Copy to /etc/tm-commons/commons.env on the server, fill in
# each value, and keep the file readable only by root and the service:
#   sudo install -m 600 -o root -g tm-commons commons.env.example /etc/tm-commons/commons.env
# Anything left as a placeholder counts as missing, and the service will not start.

# Where people reach the service. Caddy serves it here with HTTPS.
TM_COMMONS_URL=https://commons.example.invalid

# Neon: the connection string from the project's Connect dialog. The pooled one
# (host contains `-pooler`) is fine here; the service keeps no named statements.
# It ends in ?sslmode=require.
DATABASE_URL=postgresql://replace-me:replace-me@ep-replace-me.example.invalid/neondb?sslmode=require

# Optional. The direct (non-pooled) Neon string, used only to create the tables when
# the service starts. Leave it out to migrate over DATABASE_URL.
# DATABASE_URL_DIRECT=postgresql://replace-me:replace-me@ep-replace-me.example.invalid/neondb?sslmode=require

# Made by `tm-commons keygen`. Keep them secret. Changing the signing key signs out
# every Taskmaster; changing the session secret signs out every browser.
TM_COMMONS_SIGNING_KEY=replace-me
TM_COMMONS_SESSION_SECRET=replace-me

# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <TM_COMMONS_URL>/auth/google/callback
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App.
# Authorization callback URL: <TM_COMMONS_URL>/auth/github/callback
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# Who does the weekly review, comma separated: github:<username>, google:<email>, or an email.
TM_COMMONS_MODERATORS=github:replace-me

# Optional.
# TM_COMMONS_BIND=127.0.0.1:8740
# TM_COMMONS_DAILY_LIMIT=50
