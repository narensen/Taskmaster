{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taskmaster",
  "version": "0.1.5",
  "identifier": "dev.taskmaster.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "appimage", "deb"],
    "category": "DeveloperTool",
    "publisher": "Taskmaster",
    "homepage": "https://github.com/narensen/Taskmaster",
    "license": "MIT",
    "copyright": "Copyright (c) Taskmaster contributors. MIT licensed.",
    "shortDescription": "One master plans, cheap workers build in parallel, every page is checked before it is done.",
    "longDescription": "Taskmaster is a multi-model coding harness. It plans a product once, builds its pages in parallel with the harness CLIs you already have, and checks each page before calling the run done.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/tm-daemon"],
    "resources": {
      "../../web/dist/": "web/"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 180 },
        "applicationFolderPosition": { "x": 480, "y": 180 }
      }
    },
    "linux": {
      "deb": {
        "depends": ["git"],
        "recommends": ["bubblewrap", "python3-venv"],
        "section": "devel",
        "priority": "optional"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "SET_BY_RELEASE_WORKFLOW_FROM_TAURI_UPDATER_PUBKEY",
      "endpoints": ["https://github.com/narensen/Taskmaster/releases/latest/download/latest.json"]
    }
  }
}
