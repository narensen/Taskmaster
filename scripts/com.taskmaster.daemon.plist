<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.taskmaster.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/tm-daemon</string>
    <string>serve</string>
    <string>--auto-resume</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TASKMASTER_LOG_FORMAT</key>
    <string>json</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/taskmaster-daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/taskmaster-daemon.err.log</string>
</dict>
</plist>
